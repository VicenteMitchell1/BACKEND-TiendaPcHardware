# ==============================================================================
# Variables de entorno (secretos). NO suba el archivo .env a GitHub.
# Forma rápida en Windows:   .\setup-env.ps1   (genera .env con valores aleatorios)
# Forma manual:              copie este archivo como .env y reemplace los valores.
# ==============================================================================

# Clave HMAC para firmar los JWT, en Base64 (mínimo 32 bytes; recomendado 64).
# Generar en PowerShell: [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }))
JWT_SECRET=REEMPLAZAR_CON_BASE64_ALEATORIO

# Clave compartida entre el gateway y los microservicios (cabecera X-Internal-Token).
INTERNAL_API_KEY=REEMPLAZAR_CON_TEXTO_ALEATORIO

# Contraseñas de MySQL (sólo docker-compose).
DB_PASSWORD=REEMPLAZAR_CON_CLAVE_DB
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_CLAVE_ROOT

# Opcional: duración de los tokens en milisegundos.
# JWT_EXPIRATION_MS=3600000
# JWT_REFRESH_EXPIRATION_MS=604800000
